# --- data & archives (never commit recorded sessions) ---
data/
*.jsonl
!shared-fixtures/**/*.jsonl

# --- design handoff: keep extracted sources, ignore the zip ---
design/*.zip

# --- node ---
node_modules/
dist/
.vite/
*.local
.eslintcache

# --- .NET ---
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/
artifacts/

# --- python (precompute worker) ---
__pycache__/
*.py[cod]
.venv/
venv/
.fastf1-cache/

# --- env ---
.env
.env.local
*.env.local

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- logs ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- .NET build output inside backend ---
backend/**/bin/
backend/**/obj/

# Local store credentials. compose.yaml reads these; the defaults in it are
# development-only and every variable is optional (docs/22 §6).
.env
